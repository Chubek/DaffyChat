[Unit]
Description=DaffyChat Signaling Server
Documentation=https://github.com/Chubek/DaffyChat
After=network-online.target daffydmd.service
Wants=network-online.target
Requires=daffydmd.service

[Service]
Type=simple
User=daffychat
Group=daffychat
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/usr/bin/env daffy-signaling --serve-socketio /etc/daffychat/config.json
Restart=on-failure
RestartSec=5
WorkingDirectory=/opt/daffychat
StandardOutput=journal
StandardError=journal
SyslogIdentifier=daffy-signaling

[Install]
WantedBy=multi-user.target
