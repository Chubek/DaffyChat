# DaffyChat URL Rewriting for Short Room Names
# This allows accessing rooms via daffychat.ir/<room-name>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Redirect /r/<room-name> to room.html
  RewriteRule ^r/([a-zA-Z0-9-]{4,10})$ room.html [L]
  
  # Redirect /<room-name> directly to room page (if not a file/directory)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-zA-Z0-9-]{4,10})$ room.html [L]
</IfModule>
